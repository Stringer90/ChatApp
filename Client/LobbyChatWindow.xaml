<Window x:Class="Client.LobbyChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lobby Chat" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Top row with back button and lobby name -->
        <Button Content="Back" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="10,10,0,10" Padding="5,2" Click="Button_Click"/>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
            <Run Text="Lobby: "/>
            <Run Text="{Binding LobbyName}"/>
        </TextBlock>

        <!-- Left column: User list and DM chat -->
        <ListBox x:Name="UserList" Grid.Row="1" Grid.Column="0" Margin="10,10,10,180" SelectionChanged="UserList_SelectionChanged"/>
        <TextBlock Grid.Column="0" VerticalAlignment="Top" Margin="10,32,10,0" Grid.RowSpan="2"><Run Text="Online"/><Run Text=" User"/><Run Language="en-gb" Text="s"/><Run Text=":"/></TextBlock>
        <ListBox x:Name="DMChat" Grid.Row="1" Grid.Column="0" Height="120" VerticalAlignment="Bottom" Margin="10,0,10,40"/>
        <TextBox x:Name="DMInput" Grid.Row="1" Grid.Column="0" Height="30" VerticalAlignment="Bottom" Margin="10,0,70,10"/>
        <Button x:Name="SendDMBtn" Content="Send DM" Grid.Row="1" Grid.Column="0" Height="30" Width="60" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Click="SendDMBtn_Click"/>

        <!-- Main chat area -->
        <ListBox x:Name="Messages" Grid.Row="1" Grid.Column="1" Margin="10" ItemsSource="{Binding messages}"/>
        <TextBox x:Name="MesageInput" Grid.Row="2" Grid.Column="1" Height="30" Margin="10,0,70,10"/>
        <Button x:Name="SendBtn" Content="Send" Grid.Row="2" Grid.Column="1" Height="30" Width="50" HorizontalAlignment="Right" Margin="0,0,10,10" Click="SendBtn_Click"/>

        <!-- Right column: File list -->
        <ListBox x:Name="FileList" Grid.Row="1" Grid.Column="2" Margin="10,10,10,70"/>
        <Button x:Name="UploadButton" Content="Upload" Grid.Row="1" Grid.Column="2" Height="30" VerticalAlignment="Bottom" Margin="10,0,10,40" Click="UploadButton_Click"/>
        <Button x:Name="DownloadButton" Content="Download" Grid.Row="1" Grid.Column="2" Height="30" VerticalAlignment="Bottom" Margin="10,0,10,10" Click="DownloadButton_Click"/>
        <TextBlock x:Name="SelectedFileLabel" Grid.Column="2" Text="Available Files:" Margin="10,27,10,349" Grid.RowSpan="2"/>
    </Grid>
</Window>